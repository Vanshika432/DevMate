# ==============================================================================
# DevOps AI Assistant - Environment Configuration
# ==============================================================================

# LLM Configuration (Google Gemini - 100% Free via Google AI Studio)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Mock Mode (Set to true to test tools without real Jira / GitHub tokens)
MOCK_MODE=true

# GitHub Configuration
# Generate a free Personal Access Token (classic) with 'repo' scope at:
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_REPO=owner/repository-name

# Atlassian Jira Configuration (Free tier for up to 10 users)
# URL example: https://yourcompany.atlassian.net
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@domain.com
# Create a free API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=DEV

# Application Settings
APP_ENV=development
APP_PORT=8000

